{
  "name": "ls",
  "description": "列出指定目录下的条目，按字母序排列，目录加 / 后缀。",
  "parameters": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "要列出的目录路径（相对或绝对路径，默认当前目录）"
      },
      "limit": {
        "type": "integer",
        "default": 100,
        "description": "最大返回条目数"
      }
    },
    "required": []
  }
}

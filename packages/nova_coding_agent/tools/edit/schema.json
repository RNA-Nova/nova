{
  "name": "edit",
  "description": "在文件中批量替换文本片段。支持 CRLF、BOM 与多组编辑项。",
  "parameters": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "文件路径（相对或绝对路径）"
      },
      "edits": {
        "type": "array",
        "description": "要执行的编辑项列表，按顺序应用",
        "items": {
          "type": "object",
          "properties": {
            "oldText": {
              "type": "string",
              "description": "要替换的原文本"
            },
            "newText": {
              "type": "string",
              "description": "替换后的新文本"
            }
          },
          "required": ["oldText", "newText"]
        }
      },
      "encoding": {
        "type": "string",
        "default": "utf-8",
        "description": "文件编码"
      }
    },
    "required": ["path", "edits"]
  }
}

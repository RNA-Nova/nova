{
  "name": "write",
  "description": "将内容写入本地文件。如果文件不存在则创建，存在则覆盖。自动创建缺失的父目录。",
  "parameters": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "要写入的文件路径（相对或绝对路径）"
      },
      "content": {
        "type": "string",
        "description": "要写入的文件内容"
      },
      "encoding": {
        "type": "string",
        "description": "文件编码，默认为 utf-8",
        "default": "utf-8"
      }
    },
    "required": ["path", "content"]
  }
}

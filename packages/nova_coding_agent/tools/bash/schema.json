{
  "name": "bash",
  "description": "执行 shell 命令",
  "parameters": {
    "type": "object",
    "properties": {
      "command": { "type": "string", "description": "要执行的 shell 命令" },
      "cwd": { "type": "string", "description": "工作目录，默认当前目录" },
      "timeout": { "type": "integer", "default": 60, "description": "超时时间（秒）" },
      "env": { "type": "object", "description": "额外的环境变量" }
    },
    "required": ["command"]
  }
}

{
  "name": "nova-tui",
  "version": "0.1.0",
  "description": "Nova 前端运行时：后端会话管理、事件管线、呈现模型 + 内置 TUI 宿主（modes/tui）；M3 WS 宿主归 hosts/",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./modes/tui/*": {
      "types": "./dist/modes/tui/*.d.ts",
      "import": "./dist/modes/tui/*.js"
    }
  },
  "bin": {
    "nova": "dist/modes/tui/main.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "dev": "tsx src/index.ts",
    "tui": "tsx src/modes/tui/main.ts",
    "start": "node dist/modes/tui/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.80.10",
    "@types/diff": "^7.0.2",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "diff": "^9.0.0",
    "jiti": "^2.7.0",
    "marked": "^15.0.7"
  }
}
